{
	"name": "pau-table-of-contents-block",
	"version": "0.5.0",
	"description": "A block for displaying the table of contents of a collection of posts or pages that constitute a body of work -- a book. You can edit the order of appearance of articles and this is also used to add next/previous links during presentation of those pages/posts",
	"author": "Timothy Paustian",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^15.10.0",
		"@wordpress/eslint-plugin": "^23.0.0",
		"@wordpress/i18n": "^6.10.0",
		"@wordpress/scripts": "^31.2.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.37.0",
		"@wordpress/blocks": "^15.10.0",
		"@wordpress/components": "^31.0.0",
		"@wordpress/data": "^10.37.0",
		"@wordpress/element": "^6.37.0",
		"@wordpress/icons": "^11.4.0"
	}
}
